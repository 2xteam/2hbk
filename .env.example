# 로컬 개발: 이 파일을 복사해 `.env.local`로 저장한 뒤 값을 채우세요.

# MongoDB — 앱 데이터는 hamhibokka DB, 회원은 user DB를 공유한다
# DB 이름은 URI 경로가 아니라 lib/db.ts에서 못 박는다 (MongoDB Atlas 노트의 2026-09-02 사고 참고)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hamhibokka?retryWrites=true&w=majority
MONGO_DB=hamhibokka
MONGO_USER_DB=user

# 세션 공유 (Vercel에서는 Secret이 아니라 Config 타입으로 등록할 것)
NEXT_PUBLIC_COOKIE_DOMAIN=.myjane.co.kr

# 통합 로그인 포털
NEXT_PUBLIC_PORTAL_ORIGIN=https://www.myjane.co.kr

# 서버 세션 서명 키 (openssl rand -hex 32)
SESSION_SECRET=

# Cloudflare R2 — 프로필·목표 이미지
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hamhibokka
R2_PUBLIC_URL=
